{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "functions": {
    "app/main.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,.pytest_cache/**,**/__pycache__/**,.env,.env.*,**/*.db,**/*.db-*,**/*.sqlite*,build_frontend.py}"
    }
  },
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
